<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <entry name="host" type="String">
      <default>8.8.8.8</default>
    </entry>
    <entry name="pingInterval" type="Int">
      <default>1</default>
      <min>1</min>
      <max>60</max>
    </entry>
    <!-- Only one ping is ever in flight, so while the link is down this is
         what bounds the sample rate: an unanswered ping cannot be counted
         until it times out. Kept equal to pingInterval by default. -->
    <entry name="pingTimeout" type="Int">
      <default>1</default>
      <min>1</min>
      <max>60</max>
    </entry>
    <entry name="showLatencyText" type="Bool">
      <default>true</default>
    </entry>
    <entry name="defaultTimescale" type="Int">
      <default>300</default>
    </entry>
  </group>

  <group name="Appearance">
    <!-- Off by default so the indicator tracks the colour scheme, including
         light/dark switches, rather than being pinned to fixed values. -->
    <entry name="useCustomColors" type="Bool">
      <default>false</default>
    </entry>
    <!-- Breeze positive/neutral/negative, so turning custom colours on starts
         from what was already on screen instead of something jarring. -->
    <entry name="okColor" type="Color">
      <default>#27ae60</default>
    </entry>
    <entry name="warningColor" type="Color">
      <default>#f67400</default>
    </entry>
    <entry name="criticalColor" type="Color">
      <default>#da4453</default>
    </entry>

    <!-- Only has any effect on the desktop. In a panel the applet has no
         background of its own, and the popup's is chosen by the shell from the
         containment's hints (see CompactApplet.qml), not by the applet. -->
    <entry name="useCustomBackgroundOpacity" type="Bool">
      <default>false</default>
    </entry>
    <!-- min/max here mean the QML side never has to clamp. -->
    <entry name="backgroundOpacity" type="Int">
      <default>60</default>
      <min>0</min>
      <max>100</max>
    </entry>
  </group>

  <!-- These keys keep their original names. The user-facing labels are now
       OK / Warning / Critical, but renaming the keys would silently reset
       every threshold anyone had already configured. -->
  <group name="Thresholds">
    <entry name="yellowAfter" type="Int">
      <default>2</default>
      <min>1</min>
    </entry>
    <entry name="redAfter" type="Int">
      <default>5</default>
      <min>1</min>
    </entry>
    <entry name="recoverAfter" type="Int">
      <default>5</default>
      <min>1</min>
    </entry>
    <entry name="yellowMs" type="Int">
      <default>150</default>
      <min>1</min>
    </entry>
    <entry name="redMs" type="Int">
      <default>500</default>
      <min>1</min>
    </entry>
  </group>

</kcfg>
